# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-smoke/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# file nặng (mô hình 3D, ảnh gốc) nằm trên Supabase Storage, không đưa lên git
/data/

# ONNX Runtime Web cho tìm kiếm bằng ảnh: scripts/copy-ort.mjs chép từ node_modules khi cài đặt và trước dev, build
/public/image-search/ort/
# mô hình ONNX tự xuất để chạy thử trên máy (bản dùng thật tải từ NEXT_PUBLIC_IMAGE_SEARCH_MODEL_URL)
/public/image-search/models/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cấu hình riêng của từng máy
.mcp.json
.claude/settings.local.json
