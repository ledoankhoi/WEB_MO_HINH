# Chép file này thành .env.local rồi điền giá trị thật. Không đưa .env.local lên git.

# Chuỗi kết nối PostgreSQL (bắt buộc).
# Supabase: Project Settings > Database > Connection string > mục "Transaction pooler" (cổng 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<mat-khau>@<vung>.pooler.supabase.com:6543/postgres

# Chứng chỉ CA của máy chủ CSDL. Với Supabase không cần khai báo: ứng dụng tự dùng certs/supabase-ca.crt.
# DATABASE_CA_CERT=./supabase-ca.crt

# Địa chỉ công khai của trang web.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Tên miền của khu quản trị (src/proxy.ts). Mặc định admin.localhost; tên miền khác không mở được /admin.
# ADMIN_HOST=admin.example.com

# Tài khoản quản trị đầu tiên, được tạo ở lần khởi động đầu nếu chưa tồn tại.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Tài khoản nhận chuyển khoản. Có đủ bốn biến thì bật thanh toán chuyển khoản kèm mã VietQR.
# BANK_BIN=
# BANK_NAME=
# BANK_ACCOUNT_NUMBER=
# BANK_ACCOUNT_NAME=

# Khoá API Sketchfab, chỉ dùng cho `npm run models` (tải mô hình 3D). Lấy ở https://sketchfab.com/settings/password.
# SKETCHFAB_API_TOKEN=

# Kho file (mô hình .glb, ảnh sản phẩm) trên Supabase Storage. `npm run media` tải file lên bucket "media".
# SUPABASE_URL: Project Settings > API (dạng https://<ma-du-an>.supabase.co).
# SUPABASE_SECRET_KEY: Project Settings > API Keys > Secret keys. CHỈ dùng cho script, không đưa vào mã trình duyệt.
# MEDIA_BASE_URL: <SUPABASE_URL>/storage/v1/object/public/media. Dữ liệu mẫu ghi đường dẫn file theo biến này.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# MEDIA_BASE_URL=

# Tìm kiếm bằng ảnh (docs/chuan/08-tich-hop-ai.md). Mặc định trình duyệt tải bản ONNX nén 8 bit của
# CLIP ViT-B/32 (OpenAI) từ Hugging Face, không cần khai báo gì. Chỉ đặt khi tự lưu mô hình ở nơi khác
# (đọc lúc build). Nhiều phần thì liệt kê đường dẫn cách nhau bằng dấu phẩy, theo thứ tự ghép.
# Đổi mô hình thì PHẢI đổi ID rồi lập chỉ mục lại ở /admin/tim-bang-anh: vector của hai mô hình không so được.
# NEXT_PUBLIC_IMAGE_SEARCH_MODEL_URL=
# NEXT_PUBLIC_IMAGE_SEARCH_MODEL_ID=
# NEXT_PUBLIC_IMAGE_SEARCH_MODEL_LABEL=
# NEXT_PUBLIC_IMAGE_SEARCH_MODEL_MB=
